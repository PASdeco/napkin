# ── Contract deployment (server-side only, never exposed to the browser) ──
# Wallet that deploys contracts/napkin.py and pays Studionet fees.
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=

# ── Frontend (public — these are inlined into the client bundle) ──────────
NEXT_PUBLIC_NETWORK=studionet
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Optional ──────────────────────────────────────────────────────────────
# Chain / explorer overrides. Defaults match GenLayer Studionet.
NEXT_PUBLIC_GENLAYER_CHAIN_ID=61999
NEXT_PUBLIC_GENLAYER_EXPLORER=https://explorer-studio.genlayer.com

# Enables the WalletConnect option in the connect-wallet modal.
# Get one at https://cloud.reown.com — leave blank to show injected wallets only.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
